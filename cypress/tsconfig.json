{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "es2024",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": [
      "cypress",
      "node"
    ],
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "../src/*"
      ]
    },
    "jsx": "preserve"
  },
  "include": [
    "**/*.ts"
  ]
}
